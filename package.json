{
  "name": "@red-cup-engineering/topical-knowledge-cell-report-service",
  "version": "0.2.0",
  "description": "Sells idempotent source-grounded topical reports through A2A or direct ActivityPub/x402 while hiring NotebookLM separately.",
  "type": "module",
  "license": "MIT",
  "files": [
    "scripts",
    "content",
    "lib",
    "ops",
    "src"
  ],
  "exports": {
    ".": "./lib/report.mjs",
    "./law": "./lib/law.mjs",
    "./protocol": "./src/protocol.mjs",
    "./commission": "./lib/commission.mjs",
    "./runtime": "./src/compose-runtime.mjs",
    "./witness": "./src/report-witness.mjs",
    "./commission-identity": "./src/commission-identity.mjs"
  },
  "bin": {
    "serve-topical-knowledge-cell-report-a2a": "./scripts/server.mjs"
  },
  "scripts": {
    "check": "node --check lib/law.mjs && node --check lib/report.mjs && node --check lib/commission.mjs && node --check src/protocol.mjs && node --check src/runtime.mjs && node --check src/report-witness.mjs && node --check src/compose-runtime.mjs && node --check src/commission-identity.mjs && node --check scripts/execute-a2a-task.mjs && node --check scripts/server.mjs && node --check test/*.test.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.0.0-beta.0",
    "@red-cup-engineering/a2a-contracted-agent-service": "2.0.5",
    "@red-cup-engineering/a2a-rmn-part-service": "1.0.1",
    "@red-cup-engineering/a2a-sovereign-operation-boundary-service": "1.0.1",
    "@red-cup-engineering/ni-uri-services-section": "0.1.1",
    "@red-cup-engineering/relation-model-notation-cbor-codec": "0.0.1",
    "@red-cup-engineering/semantic-content-identify-service": "0.2.2",
    "@red-cup-engineering/computer-data-engineering-services-section": "0.7.1",
    "@red-cup-engineering/computer-file-engineering-services-section": "0.8.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/topical-knowledge-cell-report-service.git"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/561-group/.github/blob/main/TIPS.md"
  }
}
